<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the app's supported per-app locales for the platform LocaleManager API
  (Android 13+/API 33+). Lets the system resolve LocaleManager.setApplicationLocales()
  and own locale + layout-direction selection for every activity uniformly.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="he" />
</locale-config>
