<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Anchor theme — black background, white text, forced RTL.
         Used by MainActivity + all lockscreen activities (Manifest).
         Derived from SOURCE watchapp/res/values/themes.xml. -->
    <style name="Theme.Anchor" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
</resources>
