{
  "expo": {
    "name": "AnchorDashboardApp",
    "slug": "AnchorDashboardApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./ui/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./ui/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./ui/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./ui/assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "נדרש כדי להציג את מיקום הקשיש בהתראות חירום."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://u7cxnohim6.execute-api.us-east-1.amazonaws.com",
      "cognito": {
        "region": "us-east-1",
        "userPoolId": "us-east-1_KXDRK5VnC",
        "userPoolClientId": "1smq0heh9hmht2tti3rnb4usvi"
      },
      "eas": {
        "projectId": "39415886-a1ef-4b45-9c7e-2976cb67d430"
      }
    },
    "owner": "omris99"
  }
}
