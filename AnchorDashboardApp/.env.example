# Dashboard runtime configuration.
#
# These EXPO_PUBLIC_* variables are read in app.config.js and exposed to the app via
# expo-constants (see config/env.js). Copy this file to `.env` for local overrides, or
# set the same keys in your EAS build profile's `env` block for staging/production.
#
# If a variable is unset, app.config.js falls back to the PRODUCTION defaults shown below,
# so the app runs out-of-the-box with no .env present. These are public client config
# values (they ship in the bundle) — do NOT put real secrets here.

EXPO_PUBLIC_API_BASE_URL=https://u7cxnohim6.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_KXDRK5VnC
EXPO_PUBLIC_COGNITO_CLIENT_ID=1smq0heh9hmht2tti3rnb4usvi
